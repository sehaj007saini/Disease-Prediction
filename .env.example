# Environment configuration template for Docker Compose
# Copy this file to .env and set your actual values for local deployment.
# Note: .env is ignored by Git.

POSTGRES_DB=disease_prediction_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# JWT Authentication Security Key (Generate via: openssl rand -hex 32)
JWT_SECRET=your_custom_256_bit_random_secret_key_here

# Allowed CORS Origins (comma-separated for production domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,https://yourdomain.com

# Optional ML Microservice endpoint override
ML_SERVICE_URL=http://ml-service:5000/predict

