# Server Configuration
server.port=8080

# Spring Application Name
spring.application.name=disease-prediction-backend

# PostgreSQL Database Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/disease_prediction_db
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_password_here}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Configuration
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ML Model Microservice Endpoint Integration
ml.service.url=http://localhost:8000/predict
ml.service.timeout.ms=5000

# Jackson JSON Settings
spring.jackson.serialization.write-dates-as-timestamps=false
