# ===================================
# MediPulse AI Frontend - Environment Configuration
# ===================================

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_ML_SERVICE_URL=http://localhost:5000

# Wearable Device Integration
# Get credentials from respective developer portals

# Google Fit / Health Connect
# Get from: https://console.cloud.google.com/
VITE_GOOGLE_FIT_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Fitbit
# Get from: https://dev.fitbit.com/apps
VITE_FITBIT_CLIENT_ID=your-fitbit-client-id
VITE_FITBIT_CLIENT_SECRET=your-fitbit-client-secret

# Samsung Health
VITE_SAMSUNG_HEALTH_CLIENT_ID=your-samsung-health-client-id

# Garmin Connect (Requires API Key)
VITE_GARMIN_CONSUMER_KEY=your-garmin-consumer-key
VITE_GARMIN_CONSUMER_SECRET=your-garmin-consumer-secret

# Apple HealthKit (iOS only - no keys needed for web)
# Configured in native iOS app

# Feature Flags
VITE_ENABLE_WEARABLE_SYNC=true
VITE_ENABLE_TELEMEDICINE=false
VITE_ENABLE_AI_INSIGHTS=false

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Environment
VITE_ENV=development
